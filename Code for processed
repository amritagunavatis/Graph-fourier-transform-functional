ef compute_partial_corr_from_ts(ts):
    
    imputer = SimpleImputer(strategy='mean')
    ts = imputer.fit_transform(ts)
    n_t, n_r = ts.shape
    ts_z = np.array([zscore(ts[:, i]) for i in range(n_r)]).T
    cov, _ = ledoit_wolf(ts_z)
    prec = np.linalg.pinv(cov)
    n = prec.shape[0]
    pc = np.zeros((n, n))
    for i in range(n):
        for j in range(n):
            if i == j:
                pc[i, j] = 1.0
            else:
                denom = np.sqrt(prec[i, i] * prec[j, j])
                pc[i, j] = -prec[i, j] / denom if denom > 1e-10 else 0.0
    pc[pc < 0] = 0.0
    np.fill_diagonal(pc, 0.0)
    return pc

def load_W(feat_dir, subj, net, ts):
    
    pc_file = feat_dir / f"{subj}_{net}_partial_corr.csv"
    if pc_file.exists():
        W = np.loadtxt(pc_file, delimiter=',')
        # enforce same conventions as the fallback path: no negative
        # edges, zero diagonal, symmetric
        W = np.where(W < 0, 0.0, W)
        np.fill_diagonal(W, 0.0)
        W = (W + W.T) / 2.0
        return W, 'precomputed'
    else:
        return compute_partial_corr_from_ts(ts), 'computed'

def compute_gft(ts, W):
    """Given raw time series ts (T x ROIs) and adjacency matrix W (ROIs x ROIs),
    returns energy, eigenvalues, X_hat."""
    if W.sum() == 0:
        return None, None, None
    D = np.diag(W.sum(axis=1))
    L = D - W
    eigenvalues, eigenvectors = eigh(L)
    idx = np.argsort(eigenvalues)
    eigenvalues = eigenvalues[idx]
    eigenvectors = eigenvectors[:, idx]
    X = ts.T  # (N_rois, T)
    X_hat = eigenvectors.T @ X  # (N_modes, T)
    energy = np.sum(X_hat**2, axis=1)
    total = energy.sum()
    if total > 0:
        energy_norm = energy / total
    else:
        energy_norm = energy
    return energy_norm, eigenvalues, X_hat

